rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Members collection
    //   - Anyone can verify a known member by document ID (member_id).
    //     "get" only — listing the whole collection is denied so member
    //     records cannot be enumerated from the public site.
    //   - Writes are restricted to signed-in admin accounts.
    match /members/{memberId} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if request.auth != null;

      // Tighter variant — restrict admins to a fixed set of emails.
      // Uncomment and fill in to enforce it:
      // allow create, update, delete: if request.auth != null
      //     && request.auth.token.email in ['admin@council.example'];
    }

    // Nothing else is readable or writable from clients.
  }
}